{
    "name": "asasmoyo/yii2-saml",
    "description": "Connect Yii 2 application to a Saml Identity Provider for Single Sign On (Handbid Fork with Disney SSO support)",
    "type": "yii2-extension",
    "keywords": [
        "yii2",
        "extension",
        "saml",
        "single sign on",
        "handbid",
        "disney"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Arba Sasmoyo",
            "email": "asasmoyo@student.uns.ac.id"
        },
        {
            "name": "Muhammad Safri Juliardi",
            "email": "ardi93@gmail.com"
        },
        {
            "name": "Handbid Inc",
            "email": "dev@handbid.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "yiisoft/yii2": "^2.0.28",
        "onelogin/php-saml": "^3.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "asasmoyo\\yii2saml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "asasmoyo\\yii2saml\\tests\\": "tests/"
        }
    }
}
